{
  "components": {
    "schemas": {
      "ApplyRequest": {
        "additionalProperties": false,
        "properties": {
          "applied_by_actor_id": {
            "title": "Applied By Actor Id",
            "type": "string"
          }
        },
        "required": [
          "applied_by_actor_id"
