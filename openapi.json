        "title": "ApplyRequest",
        "type": "object"
      },
      "GraphTraceRequest": {
        "additionalProperties": false,
        "properties": {
          "max_depth": {
            "default": 3,
            "maximum": 3.0,
            "minimum": 0.0,
            "title": "Max Depth",
            "type": "integer"
          },
          "max_nodes": {
            "default": 100,
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Max Nodes",
            "type": "integer"
          },
          "relation_types": {
            "items": {
              "type": "string"
            },
            "title": "Relation Types",
            "type": "array",
            "uniqueItems": true
          },
          "start_claim_id": {
            "title": "Start Claim Id",
            "type": "string"
          }
        },
        "required": [
          "start_claim_id",
          "relation_types"
        ],
        "title": "GraphTraceRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ProposalCreate": {
        "additionalProperties": false,
        "properties": {
          "base_revision_token": {
            "minimum": 0.0,
            "title": "Base Revision Token",
            "type": "integer"
          },
          "description": {
            "default": "",
            "title": "Description",
            "type": "string"
          },
          "namespace_id": {
            "title": "Namespace Id",
            "type": "string"
          },
          "proposer_actor_id": {
            "title": "Proposer Actor Id",
            "type": "string"
          },
          "title": {
            "maxLength": 400,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "namespace_id",
          "proposer_actor_id",
          "title",
          "base_revision_token"
        ],
        "title": "ProposalCreate",
        "type": "object"
      },
      "ProposalItemCreate": {
        "additionalProperties": false,
        "properties": {
          "command_type": {
            "title": "Command Type",
            "type": "string"
          },
          "payload": {
            "additionalProperties": true,
            "title": "Payload",
            "type": "object"
          },
          "preconditions": {
            "additionalProperties": true,
            "title": "Preconditions",
            "type": "object"
          }
        },
        "required": [
          "command_type",
          "payload"
        ],
        "title": "ProposalItemCreate",
        "type": "object"
      },
      "ReviewCreate": {
        "additionalProperties": false,
        "properties": {
          "decision": {
            "enum": [
              "accept",
              "reject",
              "request_changes",
              "abstain"
            ],
            "title": "Decision",
            "type": "string"
          },
          "proposal_item_id": {
            "title": "Proposal Item Id",
            "type": "string"
          },
          "rationale": {
            "minLength": 1,
            "title": "Rationale",
            "type": "string"
          },
          "reviewer_actor_id": {
            "title": "Reviewer Actor Id",
            "type": "string"
          }
        },
        "required": [
          "proposal_item_id",
          "reviewer_actor_id",
          "decision",
          "rationale"
        ],
        "title": "ReviewCreate",
        "type": "object"
      },
      "SearchRequest": {
        "additionalProperties": false,
        "properties": {
          "limit": {
            "default": 20,
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Limit",
            "type": "integer"
          },
          "namespace_id": {
            "title": "Namespace Id",
            "type": "string"
          },
          "query": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Query",
            "type": "string"
          },
          "verdicts": {
            "items": {
              "type": "string"
            },
            "title": "Verdicts",
            "type": "array"
          }
        },
        "required": [
          "namespace_id",
          "query"
        ],
        "title": "SearchRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
